# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Memory admin API (Day 4) �?" optional, powers the /admin page
# -----------------------------------------------------------------------------
# MEMORY_API_HOST=127.0.0.1
# MEMORY_API_PORT=8700

# -----------------------------------------------------------------------------
# Escalation admin API (Day 7) �?" optional, powers the /escalations dashboard.
# Lists human-help requests filed when a caller reports a red-flag symptom or
# asks for a diagnosis (after they give permission).
# -----------------------------------------------------------------------------
# ESCALATION_API_HOST=127.0.0.1
# ESCALATION_API_PORT=8701

# -----------------------------------------------------------------------------
# Call analytics admin API (Day 8) �?" optional, powers the /analytics dashboard.
# Returns anonymised totals (total / successful / failed calls) plus recent
# call metadata. No transcripts or private details are ever exposed.
# -----------------------------------------------------------------------------
# ANALYTICS_API_HOST=127.0.0.1
# ANALYTICS_API_PORT=8702

# -----------------------------------------------------------------------------
# Health-facility lookup (Day 5) — optional. The agent uses live OpenStreetMap
# data (Nominatim + Overpass) by default and needs no keys. These overrides are
# mainly useful to demo the graceful failure path: point them at an unreachable
# URL and the agent will speak a fallback instead of going silent.
# -----------------------------------------------------------------------------
# FACILITIES_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# FACILITIES_OVERPASS_URL=https://overpass-api.de/api/interpreter

# -----------------------------------------------------------------------------
# Outbound calls (Day 6) — the agent dials people for medication / vaccination
# reminders instead of waiting to be called.
#
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID is required. For Linphone:
#   1. Create a free account at https://subscribe.linphone.org/register/email
#      and note your SIP address: sip:<username>@sip.linphone.org
#   2. LiveKit Cloud -> Telephony -> SIP Trunks -> Create outbound trunk.
#      The editor only accepts E.164 phone numbers, so use the wildcard:
#        {"name": "linphone-trunk", "address": "sip.linphone.org",
#         "transport": "SIP_TRANSPORT_TLS", "numbers": ["*"]}
#   3. Save the ST_xxxx trunk id it gives you below.
#   4. Install the Linphone app, log in with those credentials, and turn OFF
#      "Media encryption mandatory" (Settings -> Calls -> Advanced).
# See src/telephony/outbound/README.md for the full walkthrough.
# -----------------------------------------------------------------------------
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_your_linphone_trunk_id_here

# Caller ID shown on outbound calls (your Linphone identity — the trunk uses
# the wildcard, so the from-address is set per call here).
# LiveKit validates the From header like the dial target — a phone number or
# bare SIP user, NOT a full sip: URI or even user@host (LiveKit appends the
# trunk's domain). Use your bare Linphone username.
SIP_FROM_NUMBER=your-linphone-username

# How long to let the phone ring before giving up (seconds).
# SIP_RINGING_TIMEOUT=30
